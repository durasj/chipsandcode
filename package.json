{
  "name": "chipsandcode",
  "version": "0.0.1",
  "license": "MIT",
  "scripts": {
    "start": "vite dev",
    "dev": "vite dev",
    "build": "node scripts/clean-build-output.mjs && vite build && node scripts/verify-browser-sanitizer.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "npm run check && npm run test:unit && npm run test:cy",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest --ui --coverage",
    "test:cy": "cypress run",
    "test:cy:open": "cypress open",
    "railroad": "nearley-railroad",
    "postinstall": "svelte-kit sync",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-database.mjs",
    "data:export:cloudflare": "node --env-file-if-exists=.env.local scripts/export-cloudflare.mjs",
    "data:import": "node --env-file-if-exists=.env.local scripts/import-cloudflare.mjs",
    "check:cy": "tsc -p cypress/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@opentelemetry/api": "1.10.0",
    "@pixsame/cypress-plugin-visual-regression-diff": "1.0.0",
    "@rollup/pluginutils": "^5.0.2",
    "@sveltejs/adapter-vercel": "7.0.2",
    "@sveltejs/enhanced-img": "1.0.0",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/typography": "^0.5.9",
    "@testing-library/cypress": "^10.0.0",
    "@testing-library/svelte": "5.4.2",
    "@types/katex": "^0.16.2",
    "@types/nearley": "^2.11.2",
    "@types/node": "^26.6.6",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vite-pwa/sveltekit": "2.0.0",
    "@vitest/browser": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/ui": "5.1.0",
    "autoprefixer": "^10.4.14",
    "axe-core": "^4.8.0",
    "cssnano": "^6.0.1",
    "cypress": "^15.0.0",
    "cypress-axe": "^1.6.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "katex": "^0.16.8",
    "magicast": "0.5.5",
    "moo": "^0.5.2",
    "nearley": "^2.20.1",
    "postcss": "^8.4.26",
    "postcss-load-config": "^4.0.1",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.0.0",
    "rolldown": "1.2.16",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "^3.3.3",
    "tslib": "^2.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.0.0",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "yaml": "^2.8.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.8.1",
    "@markdoc/markdoc": "^0.3.2",
    "@neondatabase/serverless": "1.2.0",
    "@steeze-ui/heroicons": "^2.2.3",
    "@steeze-ui/remix-icons": "^1.1.0",
    "@steeze-ui/svelte-icon": "1.6.2",
    "@zip.js/zip.js": "^2.7.20",
    "bits-ui": "2.20.3",
    "daisyui": "^4.0.0",
    "date-fns": "4.4.0",
    "denque": "^2.1.0",
    "monaco-editor": "0.57.0",
    "screenfull": "^6.0.2",
    "svelte-confetti": "2.3.2",
    "yaml": "^2.3.1",
    "zod": "4.6.7",
    "dompurify": "3.4.17"
  },
  "overrides": {
    "unist-util-find": "1.0.2",
    "monaco-editor": {
      "dompurify": "3.4.17"
    }
  },
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#src/*": "./src/*"
  }
}
